<Window
    x:Class="DiskInspection.Views.ImageViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DiskInspection.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:myControl="clr-namespace:Heal.MyControl;assembly=ImageCtlWPF"
    Title="Image Viewer"
    Width="1000"
    Height="800"
    ResizeMode="NoResize"
    Style="{StaticResource WindowStyle}"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="47*" />
            <RowDefinition Height="292*" />
            <RowDefinition Height="53*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Border
                Margin="10,5,10,5"
                Padding="2"
                BorderThickness="3"
                CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="grdStartColor" Offset="0" Color="#d6cfc7" />
                        <GradientStop x:Name="grdStopColor" Offset="1" Color="#d9dddc" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Image Margin="5" Source="/Resources/Icons/bad.png" />
                        <Label
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Khay đĩa bất thường"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="DarkRed" />
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
        <Grid
            x:Name="grView"
            Grid.Row="1"
            Margin="5,0,5,0"
            MouseLeave="grView_MouseLeave"
            MouseMove="grView_MouseMove">
            <Border
                x:Name="bdView"
                Padding="10"
                Background="#2A2A2A"
                ClipToBounds="True"
                CornerRadius="10">
                <Image
                    x:Name="imbImage"
                    MouseDown="imbImage_MouseDown"
                    MouseLeftButtonDown="imbImage_MouseLeftButtonDown"
                    MouseLeftButtonUp="imbImage_MouseLeftButtonUp"
                    MouseMove="imbImage_MouseMove"
                    MouseWheel="imbImage_MouseWheel"
                    RenderTransformOrigin="0.5,0.5"
                    Stretch="Uniform">

                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="translateTransform" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>

                </Image>
            </Border>
            <DockPanel LastChildFill="False">
                <Button
                    x:Name="btnBack"
                    Width="20"
                    Height="40"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Background="#48494B"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="btnBack_Click"
                    DockPanel.Dock="Left"
                    Style="{StaticResource RoundButtonStyle}">
                    <Image
                        Width="18"
                        Margin="-2,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="/Resources/Icons/back.png" />
                </Button>
                <Button
                    x:Name="btnNext"
                    Width="20"
                    Height="40"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Background="#48494B"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="btnNext_Click"
                    DockPanel.Dock="Right"
                    Style="{StaticResource RoundButtonStyle}">
                    <Image
                        Width="18"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="/Resources/Icons/next.png" />
                </Button>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="5">
            <ListBox
                x:Name="lbThumbList"
                Grid.Row="1"
                Margin="5,0,5,5"
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectionChanged="lbThumbList_SelectionChanged">
                <ListBox.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#d6cfc7" />
                        <GradientStop Offset="1" Color="#d9dddc" />
                    </LinearGradientBrush>
                </ListBox.Background>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="5"
                            BorderBrush="Transparent"
                            BorderThickness="2">
                            <StackPanel Width="100">
                                <Image
                                    Width="100"
                                    Height="80"
                                    Source="{Binding Image}"
                                    Stretch="UniformToFill" />
                                <Label
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    Content="{Binding Text}"
                                    FontSize="11"
                                    Foreground="{Binding StatusColor}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="DodgerBlue" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Grid>
</Window>