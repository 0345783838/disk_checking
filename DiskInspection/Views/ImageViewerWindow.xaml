<Window
    x:Class="DiskInspection.Views.ImageViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DiskInspection.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:myControl="clr-namespace:Heal.MyControl;assembly=ImageCtlWPF"
    Title="Image Viewer"
    Background="#F0F2F5"
    WindowStartupLocation="CenterScreen">


    <Grid>
        <!--  Centered card like the example  -->
        <Grid
            Width="900"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Border
                Padding="12"
                Background="White"
                CornerRadius="8"
                Effect="{DynamicResource DropShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  Toolbar + error info  -->
                        <RowDefinition Height="*" />
                        <!--  Image area  -->
                        <RowDefinition Height="Auto" />
                        <!--  Pagination  -->
                        <RowDefinition Height="140" />
                        <!--  Thumbnails  -->
                    </Grid.RowDefinitions>


                    <!--  Toolbar  -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#222"
                                Text="{Binding FileName}" />
                            <TextBlock Text=" " />
                            <TextBlock
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Foreground="#CCC"
                                Text="|" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="#666"
                                Text="{Binding CameraName}" />
                        </StackPanel>


                        <StackPanel
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Padding="8,4"
                                Command="{Binding DownloadCommand}"
                                Content="Download" />
                            <Button
                                Width="28"
                                Height="28"
                                Command="{Binding CloseCommand}"
                                Content="✕" />
                        </StackPanel>
                    </DockPanel>


                    <!--  Error Code + Description (above image)  -->
                    <Border
                        Grid.Row="0"
                        Margin="0,36,0,0"
                        Padding="8"
                        Background="#FFF8E1"
                        BorderBrush="#FFE082"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontWeight="Bold"
                                Foreground="#BF360C"
                                Text="Error: " />
                            <TextBlock
                                Margin="6,0"
                                FontWeight="Bold"
                                Foreground="#D84315"
                                Text="{Binding ErrorCode}" />
                            <TextBlock
                                Margin="8,0"
                                Foreground="#999"
                                Text=" · " />
                            <TextBlock
                                Width="560"
                                Foreground="#333"
                                Text="{Binding ErrorDescription}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>


                    <!--  Image area (4:3 centered)  -->
                    <Grid
                        Grid.Row="1"
                        Margin="0,12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Border
                            Width="720"
                            Height="540"
                            Padding="12"
                            Background="#F7F7F7"
                            CornerRadius="6">
                            <Grid>
                                <!--  Keep aspect 4:3 by fixed size box. Inside use custom control  -->
                                <myControl:ImageBox
                                    x:Name="imbOriginalImage"
                                    Margin="5"
                                    Background="LightGray" />
                            </Grid>
                        </Border>
                    </Grid>


                    <!--  Pagination controls  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Width="36"
                            Height="28"
                            Command="{Binding PrevCommand}"
                            Content="◀" />
                        <TextBlock
                            Margin="12,0"
                            VerticalAlignment="Center"
                            Text="{Binding PageInfo}" />
                        <Button
                            Width="36"
                            Height="28"
                            Command="{Binding NextCommand}"
                            Content="▶" />
                    </StackPanel>


                    <!--  Thumbnail strip  -->
                    <Border
                        Grid.Row="3"
                        Margin="-12,8,-12,-12"
                        Background="#FAFAFA"
                        CornerRadius="6">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl Margin="8" ItemsSource="{Binding Images}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>


                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="120"
                                            Height="100"
                                            Margin="6"
                                            BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                            BorderThickness="2"
                                            CornerRadius="4">
                                            <Button Command="{Binding DataContext.SelectImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    <StackPanel
                                                        Height="28"
                                                        VerticalAlignment="Bottom"
                                                        Background="#AAFFFFFF">
                                                        <TextBlock
                                                            Margin="6,0"
                                                            FontSize="11"
                                                            Foreground="#222"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>


    <!--  Resources  -->
    <Window.Resources>
        <DropShadowEffect
            x:Key="DropShadow"
            BlurRadius="12"
            Opacity="0.12"
            ShadowDepth="4"
            Color="#444" />


        <!--  Simple Bool->Brush converter placeholder; implement in VM or code-behind if needed  -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
</Window>