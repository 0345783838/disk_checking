<Window
    x:Class="DiskInspection.Views.LoginWindows.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DiskInspection.Views.LoginWindows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Login"
    Width="340"
    Height="210"
    FontSize="11"
    Initialized="Window_Initialized"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    Style="{DynamicResource WindowStyle}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="80" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Label
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="Login"
                FontSize="17"
                FontWeight="Heavy" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,0,0">
                <Border>
                    <Image Source="/Resources/Icons/user.png" />
                </Border>
            </DockPanel>
            <StackPanel Grid.Column="1" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Label Width="60" Content="User:" />
                    <TextBox
                        x:Name="txtUser"
                        Width="130"
                        Height="22"
                        VerticalContentAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        TabIndex="0"
                        TextChanged="txtUser_TextChanged" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Label Width="60" Content="Password:" />
                    <PasswordBox
                        x:Name="txtPassWord"
                        Width="130"
                        Height="22"
                        VerticalContentAlignment="Center"
                        FontSize="12"
                        PasswordChanged="txtPassWord_PasswordChanged"
                        TabIndex="1" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Button
                        x:Name="lbRegister"
                        Margin="5,5,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Click="lbRegister_MouseClick"
                        Content="Register new account"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="Gray"
                        Visibility="Visible" />
                    <Button
                        x:Name="lbChangePass"
                        Margin="5,5,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Click="lbChangePass_MouseClick"
                        Content="Change password"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="Gray"
                        Visibility="Visible" />
                </StackPanel>
                <Canvas Grid.Column="1" Background="Transparent">
                    <Button
                        x:Name="btLogin"
                        Width="60"
                        Height="25"
                        Margin="50,0,0,0"
                        Click="btLogin_Click"
                        Content="Login"
                        TabIndex="2" />
                    <Button
                        x:Name="btCancel"
                        Width="60"
                        Height="25"
                        Margin="120,0,0,0"
                        Click="btCancel_Click"
                        Content="Cancel"
                        TabIndex="3" />
                </Canvas>
            </Grid>

        </Grid>
    </Grid>
</Window>
