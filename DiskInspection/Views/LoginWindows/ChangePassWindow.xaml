<Window
    x:Class="DiskInspection.Views.LoginWindows.ChangePassWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DiskInspection.Views.LoginWindows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Change Password"
    Width="383.211"
    Height="306.552"
    Background="#FFEEEEEE"
    Closing="Window_Closing"
    FontSize="11"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="190" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Label
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="Change Password"
                FontSize="17"
                FontWeight="Heavy" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,0,0">
                <Border>
                    <Image Source="../../Resources/Icons/user.png" />
                </Border>
            </DockPanel>
            <StackPanel Grid.Column="1" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Label Width="100" Content="User:" />
                    <ComboBox
                        x:Name="cbbUser"
                        Width="130"
                        Height="22"
                        VerticalContentAlignment="Center"
                        DisplayMemberPath="User"
                        FontWeight="Bold"
                        ItemsSource="{Binding Users}"
                        SelectedItem="{Binding SelectedUser}"
                        SelectionChanged="cbbUser_SelectionChanged"
                        TabIndex="0" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Label Width="100" Content="Current Password:" />
                    <PasswordBox
                        x:Name="txtCurPassWord"
                        Width="130"
                        Height="22"
                        VerticalContentAlignment="Center"
                        PasswordChanged="txtPassWord_PasswordChanged"
                        TabIndex="1" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Label Width="100" Content="New Password:" />
                    <PasswordBox
                        x:Name="txtNewPass"
                        Width="130"
                        Height="22"
                        VerticalContentAlignment="Center"
                        PasswordChanged="txtPassWord_PasswordChanged"
                        TabIndex="1" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Label Width="100" Content="Confirm Password:" />
                    <PasswordBox
                        x:Name="txtConfirmPass"
                        Width="130"
                        Height="22"
                        VerticalContentAlignment="Center"
                        PasswordChanged="txtPassWord_PasswordChanged"
                        TabIndex="1" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Label Width="100" Content="Admin code:" />
                    <PasswordBox
                        x:Name="txtAdminCode"
                        Width="130"
                        Height="22"
                        VerticalContentAlignment="Center"
                        PasswordChanged="txtPassWord_PasswordChanged"
                        TabIndex="1" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <Label
                        x:Name="lbHelp"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="? Help"
                        FontStyle="Italic"
                        FontWeight="SemiBold"
                        Foreground="DarkBlue"
                        Visibility="Hidden" />
                </DockPanel>
                <Canvas Grid.Column="1" Background="Transparent">
                    <Button
                        x:Name="btChangePass"
                        Width="60"
                        Height="25"
                        Margin="100,0,0,0"
                        Click="btChangePass_Click"
                        Content="Change"
                        IsEnabled="False"
                        TabIndex="2" />
                    <Button
                        x:Name="btCancel"
                        Width="60"
                        Height="25"
                        Margin="170,0,0,0"
                        Click="btCancel_Click"
                        Content="Cancel"
                        TabIndex="3" />
                </Canvas>
            </Grid>

        </Grid>
    </Grid>
</Window>
